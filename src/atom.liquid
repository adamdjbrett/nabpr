---
layout: null
permalink: /atom.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"><id>{{ site.url }}/</id><title>{{ site.title | xml_escape }}</title><updated>{{ collections.posts[0].date | date_iso }}</updated><subtitle>{{ site.description | xml_escape }}</subtitle><link href="{{ site.url }}/atom.xml" rel="self" type="application/atom+xml"/><link href="{{ site.url }}/" rel="alternate" type="text/html"/><generator uri="https://www.11ty.dev/">Eleventy</generator>
{% for post in collections.posts limit: 10 %}<entry><id>{{ post.url | absolute_url }}</id><title>{{ post.data.title | xml_escape }}</title><link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/><updated>{{ post.date | date_iso }}</updated><summary>{{ post.data.teaser | xml_escape }}</summary><content type="html">{{ post.templateContent | xml_escape }}</content><published>{{ post.date | date_iso }}</published></entry>{% endfor %}</feed>
