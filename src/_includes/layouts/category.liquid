---
layout: base.liquid
---
{% assign group = category_group %}
<section class="archive shell h-feed">
  <header class="archive-header">
    <p class="label">Blog &amp; News</p>
    <h1 class="p-name">{{ group.label }}</h1>
    <p class="lede">{{ group.posts | size }} entries filed under {{ group.label | downcase }}.</p>
  </header>
  {% assign chip_current = group.slug %}
  {% include "partials/chips.liquid" %}
  <div class="archive-list">
    {% for post in group.posts %}
      <article class="archive-row h-entry">
        <span class="archive-row__date">{{ post | post_time }}</span>
        <div>
          <h2><a class="u-url p-name" href="{{ post.url }}">{{ post.data.title | truncate: 60 }}</a></h2>
          <p class="p-summary">{{ post.data.teaser | strip_html | truncate: 180 }}</p>
        </div>
        <span class="entry__tag">{{ group.bucket | bucket_label }}</span>
      </article>
    {% endfor %}
  </div>
</section>
