# Optional. Netlify and Cloudflare Pages read this file; GitHub Pages and xmit ignore it.
# Nothing on the site depends on these headers — they only lengthen cache lifetimes for
# fingerprint-stable assets and add a few defensive headers.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=86400

/images/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
