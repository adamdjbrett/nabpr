---
layout: null
permalink: /feed.xml
redirect_from: /feed/
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>{{ site.title | xml_escape }}</title><description>{{ site.description | xml_escape }}</description><link>{{ site.url }}/</link><atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
{% for post in collections.posts limit: 10 %}<item><title>{{ post.data.title | xml_escape }}</title><link>{{ post.url | absolute_url }}</link><pubDate>{{ post.date | date_rfc }}</pubDate><description>{{ post.data.teaser | default: post.templateContent | strip_html | xml_escape }}</description><guid isPermaLink="true">{{ post.url | absolute_url }}</guid></item>{% endfor %}
</channel></rss>
