  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% if page.url == "/" %}{{ site.title }} · {{ site.name }}{% else %}{% if title %}{{ title | escape }} · {% endif %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ meta_description | default: teaser | default: site.description | strip_html | strip_newlines | truncate: 160 | escape }}">
  <link rel="canonical" href="{{ page.url | absolute_url }}">
  <script>(function(){try{var s=localStorage.getItem("nabpr-theme")||(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");document.documentElement.setAttribute("data-theme",s);document.documentElement.setAttribute("data-pf-theme",s)}catch(e){}})()</script>
  <link rel="stylesheet" href="/assets/css/site.css">
  <link rel="preload" href="/assets/fonts/fraunces-normal-500-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/newsreader-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin>

  <meta name="generator" content="{{ generator }}">
  <link rel="author" type="text/plain" href="/humans.txt">

  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} · RSS" href="/feed.xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} · RSS (/feed/)" href="/feed/feed.rss">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }} · Atom" href="/atom.xml">
  <link rel="alternate" type="application/feed+json" title="{{ site.title }} · JSON Feed" href="/feed/feed.json">
  <link rel="alternate" type="text/plain" title="{{ site.title }} · twtxt" href="/feed/twtxt.txt">

  <link rel="icon" href="/assets/img/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon-180x180-precomposed.png">
  <link rel="mask-icon" href="/assets/img/safari-pinned-tab.svg" color="#005e2b">
  <link rel="manifest" href="/assets/img/site.webmanifest">
  <meta name="msapplication-config" content="/assets/img/browserconfig.xml">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f0e4">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#060d07">
  <meta property="og:title" content="{{ title | default: site.slogan | escape }}">
  <meta property="og:description" content="{{ meta_description | default: teaser | default: site.description | strip_html | strip_newlines | truncate: 160 | escape }}">
  <meta property="og:url" content="{{ page.url | absolute_url }}">
  <meta property="og:type" content="{% if page.inputPath contains '/posts/' %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ site.language | default: 'en-US' | replace: '-', '_' }}">
  {% assign share_image = image.title | default: site.logo %}
  <meta property="og:image" content="{{ share_image | absolute_url }}">
  <meta property="og:image:alt" content="{{ image.alt | default: image.caption | default: site.name | strip_html | escape }}">
  {% if page.inputPath contains '/posts/' %}
  <meta property="article:published_time" content="{{ page.date | date_iso }}">
  <meta property="article:publisher" content="{{ site.social.facebook }}">
  {% assign updated = modified | default: updated %}{% if updated %}<meta property="article:modified_time" content="{{ updated | date_iso }}">{% endif %}
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@nabpr1">
  <meta name="twitter:title" content="{{ title | default: site.slogan | escape }}">
  <meta name="twitter:description" content="{{ meta_description | default: teaser | default: site.description | strip_html | strip_newlines | truncate: 160 | escape }}">
  <meta name="twitter:image" content="{{ share_image | absolute_url }}">
  {% assign resolved_author_name = authors[site.author].name | default: site.name %}
  {% if author %}{% assign resolved_author_name = authors[author].name | default: author %}{% endif %}
  {% assign iso_language = site.language | default: "en-US" | slice: 0, 2 %}
  {% assign cite_url = page.url | absolute_url %}
  {% assign cite_title = title | default: site.slogan | strip_html | escape %}
  {% assign cite_date = page.date | date: '%Y-%m-%d' %}
  {% assign cite_subjects = categories | concat: tags | uniq %}
  {% for social in socials %}{% if social.me %}<link rel="me" href="{{ social.url }}">
  {% endif %}{% endfor %}
  {% comment %}Dublin Core (DC-HTML) on every page.{% endcomment %}
  <link rel="schema.DC" href="http://purl.org/dc/elements/1.1/">
  <link rel="schema.DCTERMS" href="http://purl.org/dc/terms/">
  <meta name="DC.title" content="{{ cite_title }}">
  <meta name="DC.publisher" content="{{ site.name | escape }}">
  <meta name="DC.type" scheme="DCTERMS.DCMIType" content="Text">
  <meta name="DC.format" scheme="DCTERMS.IMT" content="text/html">
  <meta name="DC.identifier" scheme="DCTERMS.URI" content="{{ cite_url }}">
  <meta name="DC.language" scheme="DCTERMS.RFC4646" content="{{ iso_language }}">
  <meta name="DCTERMS.isPartOf" scheme="DCTERMS.URI" content="{{ site.url }}/">
  {% if meta_description or teaser %}<meta name="DC.description" content="{{ meta_description | default: teaser | strip_html | strip_newlines | escape }}">{% endif %}
  {% if page.date %}<meta name="DC.date" scheme="DCTERMS.W3CDTF" content="{{ cite_date }}">
  <meta name="DCTERMS.issued" scheme="DCTERMS.W3CDTF" content="{{ cite_date }}">{% endif %}
  {% if modified %}<meta name="DCTERMS.modified" scheme="DCTERMS.W3CDTF" content="{{ modified | date: '%Y-%m-%d' }}">{% endif %}
  {% for subject in cite_subjects %}{% if subject %}<meta name="DC.subject" content="{{ subject | escape }}">
  {% endif %}{% endfor %}
  {% comment %}Zotero: zotero:itemType forces the item type (needs the zotero: prefix on <html>).
  citation_title / citation_journal_title are deliberately absent: the first makes Zotero guess
  journalArticle, the second forces it. The title rides on og:title / DC.title.{% endcomment %}
  <meta name="prism.publicationName" content="{{ site.name | escape }}">
  <meta name="prism.url" content="{{ cite_url }}">
  <meta name="citation_public_url" content="{{ cite_url }}">
  <meta name="citation_fulltext_html_url" content="{{ cite_url }}">
  <meta name="citation_publisher" content="{{ site.name | escape }}">
  <meta name="citation_language" content="{{ iso_language }}">
  {% if page.inputPath contains '/posts/' %}
  <link rel="cite-as" href="{{ cite_url }}">
  <link rel="describedby" type="application/ld+json" href="{{ page.url }}metadata.json">
  <link rel="type" href="https://schema.org/BlogPosting">
  <link rel="alternate" type="application/activity+json" href="https://fed.brid.gy/r/{{ cite_url }}">
  <meta property="zotero:itemType" content="blogPost">
  <meta name="prism.genre" content="blogentry">
  <meta name="DC.creator" content="{{ resolved_author_name | escape }}">
  <meta name="citation_author" content="{{ resolved_author_name | escape }}">
  <meta name="citation_publication_date" content="{{ page.date | date: '%Y/%m/%d' }}">
  <meta name="citation_online_date" content="{{ page.date | date: '%Y/%m/%d' }}">
  {% for subject in cite_subjects %}{% if subject %}<meta name="citation_keywords" content="{{ subject | escape }}">
  {% endif %}{% endfor %}
  {% else %}
  <meta property="zotero:itemType" content="webpage">
  {% if author %}
  <meta name="DC.creator" content="{{ resolved_author_name | escape }}">
  <meta name="citation_author" content="{{ resolved_author_name | escape }}">
  {% else %}
  <meta name="DC.creator" content="{{ site.name | escape }}">
  {% endif %}
  {% if page.date %}<meta name="citation_publication_date" content="{{ page.date | date: '%Y/%m/%d' }}">{% endif %}
  {% endif %}
  {% include "partials/schema.liquid" %}
  <script>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
    gtag("js",new Date);gtag("config","{{ site.analytics }}");
    /* Loaded after paint: the tag is 164 KB of main-thread work and was delaying LCP. */
    addEventListener("load",function(){var i=function(){var s=document.createElement("script");s.async=1;s.src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics }}";document.head.appendChild(s)};"requestIdleCallback"in window?requestIdleCallback(i,{timeout:3000}):setTimeout(i,1200)})
  </script>
